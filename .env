APP_ENV=dev
APP_SECRET=changeme_use_a_long_random_string_here

# Music directory on the HOST machine (mapped into container as /var/lib/music)
# Windows example: MUSIC_DIR_HOST=C:/Users/YourName/Music
# Linux/Ubuntu example: MUSIC_DIR_HOST=/var/lib/music
# Default (relative path, folder "music/" next to docker-compose.yml):
MUSIC_DIR_HOST=./music

# MariaDB connection
DATABASE_URL="mysql://app:app_secret@mariadb:3306/music_player?serverVersion=mariadb-11.0.0&charset=utf8mb4"

# MariaDB credentials (used by docker-compose)
MARIADB_DATABASE=music_player
MARIADB_USER=app
MARIADB_PASSWORD=app_secret
MARIADB_ROOT_PASSWORD=root_secret

# Music library directory (bind mounted into container)
MUSIC_DIR=/var/lib/music

###> symfony/framework-bundle ###
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###
