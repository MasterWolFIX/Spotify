{% extends 'base.html.twig' %}
{% block title %}All Songs — MusicPlayer{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1 class="page-title">All Songs</h1>
        <div class="page-subtitle">{{ songCount }} track{{ songCount != 1 ? 's' : '' }} in your library</div>
    </div>
    <div style="display:flex;gap:8px;align-items:center">
        {% if is_granted('ROLE_ADMIN') %}
            <button class="btn btn-secondary btn-sm" data-action="scan">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
                </svg>
                Scan Library
            </button>
            <button class="btn btn-primary btn-sm" data-action="upload">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/>
                    <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/>
                </svg>
                Upload MP3
            </button>
        {% endif %}
    </div>
</div>

{% if songs|length == 0 %}
    <div style="text-align:center;padding:80px 20px;color:var(--text-muted)">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin:0 auto 16px;display:block;opacity:.3">
            <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
        </svg>
        <p style="font-size:1.1rem;margin-bottom:8px">No songs in your library</p>
        <p style="font-size:.875rem">
            {% if is_granted('ROLE_ADMIN') %}
                Upload MP3 files or scan the library directory to get started.
            {% else %}
                Ask an admin to add music to the library.
            {% endif %}
        </p>
    </div>
{% else %}
    <table class="song-table" role="grid">
        <thead>
            <tr>
                <th class="col-num" aria-label="Number">#</th>
                <th>Title</th>
                <th>Artist</th>
                <th>Album</th>
                <th class="col-duration">Time</th>
                <th class="col-actions"></th>
            </tr>
        </thead>
        <tbody id="songs-tbody">
            {% for song in songs %}
            <tr data-song-id="{{ song.id }}" role="row" tabindex="0"
                aria-label="{{ song.getDisplayName() }}">
                <td class="col-num">
                    <span class="row-num">{{ loop.index }}</span>
                    <svg class="playing-indicator" viewBox="0 0 24 24" fill="currentColor" aria-label="Now playing">
                        <rect x="2" y="10" width="4" height="10" rx="1"><animate attributeName="height" values="10;4;10" dur="1s" repeatCount="indefinite"/><animate attributeName="y" values="10;14;10" dur="1s" repeatCount="indefinite"/></rect>
                        <rect x="10" y="6" width="4" height="14" rx="1"><animate attributeName="height" values="14;6;14" dur="0.8s" repeatCount="indefinite"/><animate attributeName="y" values="6;10;6" dur="0.8s" repeatCount="indefinite"/></rect>
                        <rect x="18" y="8" width="4" height="12" rx="1"><animate attributeName="height" values="12;5;12" dur="1.2s" repeatCount="indefinite"/><animate attributeName="y" values="8;12;8" dur="1.2s" repeatCount="indefinite"/></rect>
                    </svg>
                </td>
                <td class="col-title">{{ song.title }}</td>
                <td>{{ song.artist ?? '' }}</td>
                <td>{{ song.album ?? '' }}</td>
                <td class="col-duration">{{ song.getFormattedDuration() }}</td>
                <td class="col-actions">
                    {% if app.user %}
                    <button class="btn btn-ghost btn-sm btn-icon btn-action" data-add-to-playlist="{{ song.id }}" title="Add to playlist">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                    </button>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') %}
                    <button class="btn btn-ghost btn-sm btn-icon btn-action"
                            data-delete-song="{{ song.id }}"
                            data-song-name="{{ song.title|e('html_attr') }}"
                            title="Delete song">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                            <path d="M10 11v6M14 11v6"/>
                        </svg>
                    </button>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}

<script>
window._songQueue = {{ songs|map(s => {
    'id': s.id,
    'title': s.title,
    'artist': s.artist,
    'album': s.album,
    'duration': s.duration,
    'formattedDuration': s.getFormattedDuration(),
    'streamUrl': path('app_songs_stream', {id: s.id})
})|json_encode|raw }};
</script>
{% endblock %}