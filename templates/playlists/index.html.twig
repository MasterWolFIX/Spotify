{% extends 'base.html.twig' %}
{% block title %}Your Playlists — MusicPlayer{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1 class="page-title">Your Playlists</h1>
        <div class="page-subtitle">{{ playlists|length }} playlist{{ playlists|length != 1 ? 's' : '' }} in your collection</div>
    </div>
    {% if app.user %}
    <button class="btn btn-primary" id="btn-page-new-playlist">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        New Playlist
    </button>
    {% endif %}
</div>

{% if playlists|length == 0 %}
    <div style="text-align:center;padding:100px 20px;background:rgba(24,18,47,0.3);border-radius:var(--radius-xl);border:1px dashed var(--border);">
        <div style="width:64px;height:64px;border-radius:50%;background:var(--accent-subtle);display:flex;align-items:center;justify-content:center;margin:0 auto 18px;color:var(--accent-light);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
                <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
            </svg>
        </div>
        <p style="font-size:1.2rem;font-weight:700;color:#fff;margin-bottom:6px">No playlists yet</p>
        <p style="color:var(--text-muted);font-size:0.9rem;max-width:380px;margin:0 auto 20px;">Create playlists, group your favourite songs and rearrange them however you like.</p>
        {% if app.user %}
        <button class="btn btn-primary btn-sm" onclick="document.querySelector('#btn-page-new-playlist').click()">
            Create your first playlist
        </button>
        {% endif %}
    </div>
{% else %}
    <div class="card-grid" id="playlist-grid">
        {% for playlist in playlists %}
        <a class="card playlist-card" href="{{ path('app_playlists_show', {id: playlist.id}) }}" style="position:relative;display:flex;flex-direction:column;justify-content:space-between;cursor:pointer;text-decoration:none;">
            <div>
                <div class="card-icon" style="border-radius:var(--radius-md);margin-bottom:14px;background:linear-gradient(135deg,rgba(139,92,246,0.3) 0%,rgba(109,40,217,0.6) 100%);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;">
                    {% if playlist.imagePath %}
                        <img src="{{ asset('uploads/playlists/' ~ playlist.imagePath) }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.6;transition:opacity 0.2s;" onmouseover="this.style.opacity='0.4'" onmouseout="this.style.opacity='0.6'" alt="Cover">
                    {% else %}
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="rgba(255,255,255,0.7)">
                            <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                        </svg>
                    {% endif %}
                    <div style="position:absolute;bottom:12px;right:12px;width:44px;height:44px;border-radius:50%;background:var(--accent);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 14px rgba(0,0,0,0.4);" class="card-play-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7L8 5z"/></svg>
                    </div>
                </div>
                <div class="card-name">{{ playlist.name }}</div>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;margin-top:10px;padding-top:10px;border-top:1px solid rgba(255,255,255,0.06);">
                <div class="card-meta">{{ playlist.getSongCount() }} song{{ playlist.getSongCount() != 1 ? 's' : '' }}</div>
                <span style="font-size:0.75rem;font-weight:700;color:var(--text-accent);">Open &rarr;</span>
            </div>
        </a>
        {% endfor %}
    </div>
{% endif %}

<script>
document.querySelector('#btn-page-new-playlist')?.addEventListener('click', () => {
    document.querySelector('#modal-global-playlist')?.classList.add('open');
    document.querySelector('#global-playlist-name-input')?.focus();
});
</script>
{% endblock %}