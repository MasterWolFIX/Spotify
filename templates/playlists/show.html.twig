{% extends 'base.html.twig' %}
{% block title %}{{ playlist.name }} — MusicPlayer{% endblock %}

{% block body %}
{# Hero banner for playlist #}
<div style="display:flex;align-items:flex-end;gap:28px;padding:32px;margin-bottom:32px;background:linear-gradient(180deg, rgba(139,92,246,0.2) 0%, rgba(16,11,33,0.6) 100%);border-radius:var(--radius-xl);border:1px solid var(--border);">
    <div style="width:160px;height:160px;border-radius:var(--radius-lg);background:var(--accent-gradient);display:flex;align-items:center;justify-content:center;box-shadow:0 10px 30px rgba(124,58,237,0.4);flex-shrink:0;">
        <svg width="72" height="72" viewBox="0 0 24 24" fill="white">
            <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
        </svg>
    </div>
    <div style="flex:1;min-width:0;">
        <a href="{{ path('app_playlists_index') }}" style="font-size:0.8rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-accent);margin-bottom:8px;display:inline-block">
            &larr; Wszystkie Playlisty
        </a>
        <h1 style="font-size:2.4rem;font-weight:800;color:#fff;margin-bottom:10px;line-height:1.1;letter-spacing:-0.02em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
            {{ playlist.name }}
        </h1>
        <div style="display:flex;align-items:center;gap:12px;font-size:0.88rem;color:var(--text-secondary);">
            <span>Stworzona przez: <strong style="color:#fff">{{ playlist.createdBy ? playlist.createdBy.email : 'System' }}</strong></span>
            <span>&bull;</span>
            <span>{{ playlist.getSongCount() }} {{ playlist.getSongCount() == 1 ? 'utwór' : (playlist.getSongCount() in [2,3,4] ? 'utwory' : 'utworów') }}</span>
        </div>
    </div>
    <div style="display:flex;gap:10px;align-self:flex-end;">
        {% if playlist.getSongCount() > 0 %}
        <button class="btn btn-primary" id="btn-play-playlist" style="padding:10px 22px;font-size:0.95rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
                <path d="M8 5v14l11-7L8 5z"/>
            </svg>
            Odtwórz wszystko
        </button>
        {% endif %}
        {% if is_granted('ROLE_ADMIN') or (app.user and playlist.createdBy == app.user) %}
        <button class="btn btn-danger" id="btn-delete-playlist" data-id="{{ playlist.id }}" title="Usuń tę playlistę">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/>
            </svg>
            Usuń playlistę
        </button>
        {% endif %}
    </div>
</div>

{% if playlist.playlistSongs|length == 0 %}
    <div style="text-align:center;padding:80px 20px;background:rgba(24, 18, 47, 0.3);border-radius:var(--radius-xl);border:1px dashed var(--border);">
        <p style="font-size:1.15rem;font-weight:700;color:#fff;margin-bottom:8px">Ta playlista jest jeszcze pusta</p>
        <p class="text-muted" style="font-size:0.9rem;margin-bottom:20px">Przejdź do biblioteki utworów i kliknij ikonę <strong>+</strong> przy piosence, aby ją tutaj dodać.</p>
        <a href="{{ path('app_home') }}" class="btn btn-primary btn-sm">Przejdź do utworów</a>
    </div>
{% else %}
    <table class="song-table" id="playlist-table" role="grid">
        <thead>
            <tr>
                <th class="col-num" style="width:60px">#</th>
                <th>Tytuł</th>
                <th>Wykonawca</th>
                <th>Album</th>
                <th class="col-duration">Czas</th>
                <th class="col-actions"></th>
            </tr>
        </thead>
        <tbody id="playlist-tbody">
            {% for ps in playlist.playlistSongs %}
            {% set song = ps.song %}
            <tr data-song-id="{{ song.id }}" data-ps-id="{{ ps.id }}" role="row" tabindex="0" title="Kliknij, aby odtworzyć (przeciągnij, aby zmienić kolejność)">
                <td class="col-num">
                    <span class="row-num" style="cursor:grab;">⋮⋮ {{ loop.index }}</span>
                    <svg class="playing-indicator" viewBox="0 0 24 24" fill="currentColor">
                        <rect x="2" y="10" width="4" height="10" rx="1"><animate attributeName="height" values="10;4;10" dur="1s" repeatCount="indefinite"/><animate attributeName="y" values="10;14;10" dur="1s" repeatCount="indefinite"/></rect>
                        <rect x="10" y="6" width="4" height="14" rx="1"><animate attributeName="height" values="14;6;14" dur="0.8s" repeatCount="indefinite"/><animate attributeName="y" values="6;10;6" dur="0.8s" repeatCount="indefinite"/></rect>
                        <rect x="18" y="8" width="4" height="12" rx="1"><animate attributeName="height" values="12;5;12" dur="1.2s" repeatCount="indefinite"/><animate attributeName="y" values="8;12;8" dur="1.2s" repeatCount="indefinite"/></rect>
                    </svg>
                </td>
                <td class="col-title">{{ song.title }}</td>
                <td>{{ song.artist ?? '—' }}</td>
                <td>{{ song.album ?? '—' }}</td>
                <td class="col-duration">{{ song.getFormattedDuration() }}</td>
                <td class="col-actions">
                    {% if is_granted('ROLE_ADMIN') or (app.user and playlist.createdBy == app.user) %}
                    <button class="btn btn-ghost btn-sm btn-icon btn-action"
                            data-remove-from-playlist="{{ song.id }}"
                            data-playlist-id="{{ playlist.id }}"
                            title="Usuń z playlisty">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}

<script>
const _playlistId = {{ playlist.id }};
window._songQueue = {{ playlist.playlistSongs|map(ps => {
    'id': ps.song.id,
    'title': ps.song.title,
    'artist': ps.song.artist,
    'album': ps.song.album,
    'streamUrl': path('app_songs_stream', {id: ps.song.id})
})|json_encode|raw }};

// Play all button
document.querySelector('#btn-play-playlist')?.addEventListener('click', () => {
    if (window._songQueue && window._songQueue.length) {
        window.player.setQueue(window._songQueue, 0);
    }
});

// Delete playlist
document.querySelector('#btn-delete-playlist')?.addEventListener('click', async () => {
    if (!confirm('Czy na pewno chcesz usunąć tę playlistę? (Utwory pozostaną nienaruszone w bibliotece.)')) return;
    try {
        const resp = await fetch(`/playlists/${_playlistId}`, { method: 'DELETE' });
        if (resp.ok) {
            showToast('Playlista została usunięta.', 'success');
            setTimeout(() => window.location.href = '/playlists', 400);
        } else {
            showToast('Błąd usuwania playlisty.', 'error');
        }
    } catch(e) {
        showToast('Błąd połączenia.', 'error');
    }
});

// Remove single track from playlist
document.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-remove-from-playlist]');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();

    const songId = btn.dataset.removeFromPlaylist;
    const playlistId = btn.dataset.playlistId;

    try {
        const resp = await fetch(`/playlists/${playlistId}/songs/${songId}`, { method: 'DELETE' });
        if (resp.ok) {
            btn.closest('tr')?.remove();
            showToast('Usunięto utwór z playlisty.', 'success');
            if (window._songQueue) {
                window._songQueue = window._songQueue.filter(s => s.id !== parseInt(songId));
            }
            refreshSidebarPlaylists();
        } else {
            showToast('Nie udało się usunąć utworu.', 'error');
        }
    } catch(e) {
        showToast('Błąd połączenia.', 'error');
    }
});

// Drag & drop reorder
function initSortable() {
    const tbody = document.querySelector('#playlist-tbody');
    if (tbody && typeof Sortable !== 'undefined') {
        Sortable.create(tbody, {
            animation: 180,
            ghostClass: 'sortable-ghost',
            dragClass: 'sortable-drag',
            handle: 'tr',
            onEnd: async () => {
                const order = Array.from(document.querySelectorAll('#playlist-tbody tr'))
                    .map(tr => parseInt(tr.dataset.songId));
                await fetch(`/playlists/${_playlistId}/reorder`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ order })
                });
                if (window._songQueue) {
                    window._songQueue = order.map(id => window._songQueue.find(s => s.id === id)).filter(Boolean);
                }
                showToast('Zapisano kolejność utworów!', 'success');
            }
        });
    }
}
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSortable);
} else {
    initSortable();
}
</script>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js" integrity="sha256-WCHOiAhN/j2+C4fYJxfUb5pN8E9mS7MFcYl6bMnJsE=" crossorigin="anonymous"></script>
{% endblock %}