<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MusicPlayer{% endblock %}</title>
    <link rel="icon" type="image/jpeg" href="{{ asset('favicon.jpg') }}">
    <link rel="shortcut icon" href="{{ asset('favicon.jpg') }}">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<div class="app-shell">

    {# ── SIDEBAR ───────────────────────────────────────────── #}
    <aside class="sidebar">
        <div class="sidebar-header">
            <a href="{{ path('app_home') }}" class="sidebar-logo">
                <span class="sidebar-logo-dot"></span>
                MusicPlayer
            </a>
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-section-label">Library</div>
            <a href="{{ path('app_home') }}" class="sidebar-link {% if app.request.get('_route') == 'app_home' or app.request.get('_route') == 'app_songs_index' %}active{% endif %}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                <span>All Songs</span>
            </a>
            <a href="{{ path('app_playlists_index') }}" class="sidebar-link {% if app.request.get('_route') starts with 'app_playlists' %}active{% endif %}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                <span>Playlists</span>
            </a>
            <a href="{{ path('app_stats') }}" class="sidebar-link {% if app.request.get('_route') starts with 'app_stats' %}active{% endif %}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                <span>Statistics</span>
            </a>

            {% if is_granted('ROLE_ADMIN') %}
            <div class="sidebar-section-label" style="margin-top:16px">Admin</div>
            <button class="sidebar-link btn-scan" data-action="scan" style="width:100%;text-align:left;background:none;border:none;cursor:pointer;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                <span>Scan Library</span>
            </button>
            <button class="sidebar-link btn-upload" data-action="upload" style="width:100%;text-align:left;background:none;border:none;cursor:pointer;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
                <span>Upload MP3</span>
            </button>
            {% endif %}
        </nav>

        {# Playlists #}
        <div class="sidebar-playlists">
            <div class="sidebar-playlists-header">
                <span class="sidebar-section-label" style="margin:0">Your Playlists</span>
                {% if app.user %}
                <button class="sidebar-new-playlist-btn" id="btn-sidebar-new-playlist" title="New playlist">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
                {% endif %}
            </div>
            <div id="sidebar-playlists-list" class="sidebar-playlists-list">
                {% if playlists is defined and playlists|length > 0 %}
                    {% for playlist in playlists %}
                    <a href="{{ path('app_playlists_show', {id: playlist.id}) }}"
                       class="sidebar-playlist-item {% if app.request.get('id') == playlist.id %}active{% endif %}"
                       data-sidebar-playlist-id="{{ playlist.id }}">
                        <span class="sidebar-playlist-dot"></span>
                        <span class="sidebar-playlist-name">{{ playlist.name }}</span>
                        <span class="sidebar-playlist-count">{{ playlist.getSongCount() }}</span>
                    </a>
                    {% endfor %}
                {% endif %}
            </div>
        </div>

        {# User info at bottom #}
        <div class="sidebar-footer">
            {% if app.user %}
                <div class="sidebar-user-row">
                    <div class="sidebar-user-avatar">{{ app.user.email|first|upper }}</div>
                    <div class="sidebar-user-info">
                        <div class="sidebar-user-email">{{ app.user.email }}</div>
                        {% if is_granted('ROLE_ADMIN') %}<span class="admin-badge">Admin</span>{% endif %}
                    </div>
                    <a href="{{ path('app_logout') }}" class="sidebar-logout" title="Log out">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    </a>
                </div>
            {% else %}
                <div style="display:flex;flex-direction:column;gap:8px;width:100%">
                    <a href="{{ path('app_login') }}" class="btn btn-primary" style="width:100%;justify-content:center;">Log In</a>
                    <a href="{{ path('app_register') }}" class="btn btn-secondary" style="width:100%;justify-content:center;">Sign Up</a>
                </div>
            {% endif %}
        </div>
    </aside>

    {# ── MAIN AREA ─────────────────────────────────────────── #}
    <div class="main-area">
        {# Mini top bar inside main #}
        <header class="main-topbar">
            <div class="main-search">
                <div class="search-input-wrapper">
                    <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input class="search-input" type="text" id="live-search-input"
                           placeholder="Search songs, artists, albums..."
                           value="{{ app.request.query.get('q', '') }}"
                           autocomplete="off">
                    <span class="search-spinner hidden" id="search-spinner"></span>
                </div>
            </div>
        </header>

        {# Page content #}
        <main class="main-content" id="main-view">
            {% block body %}{% endblock %}
        </main>
    </div>

</div>{# .app-shell #}

{# ── PLAYER BAR ────────────────────────────────────────────── #}
<div class="player-bar">
    {# Track info #}
    <div class="player-track">
        <div class="player-thumb">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
            </svg>
        </div>
        <div class="player-track-info">
            <div class="player-track-title" id="player-title">No track selected</div>
            <div class="player-track-artist" id="player-artist">Choose a song from the list</div>
        </div>
    </div>

    {# Controls #}
    <div class="player-controls">
        <div class="player-buttons">
            <button class="btn-control" id="btn-shuffle" title="Shuffle">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>
            </button>
            <button class="btn-control" id="btn-prev" title="Previous">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6 8.5 6V6z"/></svg>
            </button>
            <button class="btn-play-pause" id="btn-play-pause" title="Play / Pause">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
                    <path class="icon-play-pause" d="M8 5v14l11-7L8 5z"/>
                </svg>
            </button>
            <button class="btn-control" id="btn-next" title="Next">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zm2.5-6 5.5 4V8l-5.5 4zm7.5-6h2v12h-2z"/></svg>
            </button>
            <button class="btn-control" id="btn-repeat" title="Repeat" style="position:relative;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                <span class="repeat-badge-one hidden" id="repeat-badge-1">1</span>
            </button>
        </div>
        <div class="player-progress">
            <span class="player-time" id="time-current">0:00</span>
            <div class="progress-track" id="progress-track">
                <div class="progress-fill" id="progress-fill" style="width:0%"></div>
                <div class="progress-thumb" id="progress-thumb" style="left:0%"></div>
            </div>
            <span class="player-time time-right" id="time-duration">0:00</span>
        </div>
    </div>

    {# Volume #}
    <div class="player-volume">
        <button class="btn-control" id="btn-mute" title="Mute">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
            </svg>
        </button>
        <div style="display:flex;align-items:center;gap:8px;flex:1;">
            <input class="volume-slider" type="range" id="volume-slider" min="0" max="2" step="0.01" value="1">
            <span class="volume-label" id="volume-label">100%</span>
        </div>
    </div>
</div>

{# Hidden upload input #}
<input type="file" id="upload-input" accept=".mp3,audio/mpeg" multiple style="display:none">

{# New Playlist Modal #}
<div class="modal-overlay" id="modal-global-playlist">
    <div class="modal">
        <div class="modal-title">Create new playlist</div>
        <div class="form-group">
            <label class="form-label" for="global-playlist-name-input">Playlist name</label>
            <input class="form-input" type="text" id="global-playlist-name-input" placeholder="e.g. Favourites, Evening Chill...">
        </div>
        <div class="modal-actions">
            <button class="btn btn-secondary" id="btn-cancel-global-playlist">Cancel</button>
            <button class="btn btn-primary" id="btn-confirm-global-playlist">Create</button>
        </div>
    </div>
</div>

{# Add to Playlist Modal #}
<div class="modal-overlay" id="modal-add-to-playlist">
    <div class="modal">
        <div class="modal-title">Add to playlist</div>
        <div id="add-to-playlist-options" style="display:flex;flex-direction:column;gap:8px;max-height:220px;overflow-y:auto;margin-bottom:16px;">
            <p style="font-size:0.85rem;color:var(--text-muted)">Loading playlists...</p>
        </div>
        <div class="modal-actions">
            <button class="btn btn-secondary" id="btn-cancel-add-to-playlist">Close</button>
        </div>
    </div>
</div>

<div class="toast-container"></div>

<script src="{{ asset('js/player.js') }}"></script>
<script src="{{ asset('js/library.js') }}"></script>
<script>
async function refreshSidebarPlaylists() {
    try {
        const resp = await fetch('/playlists/data');
        if (!resp.ok) return;
        const playlists = await resp.json();
        const container = document.querySelector('#sidebar-playlists-list');
        if (!container) return;
        container.innerHTML = '';
        if (!playlists.length) {
            container.innerHTML = '<span style="font-size:0.8rem;color:var(--text-muted);padding:6px 12px;display:block">No playlists yet</span>';
            return;
        }
        const currentPath = window.location.pathname;
        playlists.forEach(p => {
            const isActive = currentPath === `/playlists/${p.id}`;
            const item = document.createElement('a');
            item.href = p.url || `/playlists/${p.id}`;
            item.className = `sidebar-playlist-item ${isActive ? 'active' : ''}`;
            item.dataset.sidebarPlaylistId = p.id;
            item.innerHTML = `
                <span class="sidebar-playlist-dot"></span>
                <span class="sidebar-playlist-name">${escHtml(p.name)}</span>
                <span class="sidebar-playlist-count">${p.songCount || 0}</span>
            `;
            container.appendChild(item);
        });
    } catch(e) {}
}

document.addEventListener('DOMContentLoaded', () => {
    refreshSidebarPlaylists();

    document.querySelector('#btn-sidebar-new-playlist')?.addEventListener('click', () => {
        document.querySelector('#modal-global-playlist')?.classList.add('open');
        document.querySelector('#global-playlist-name-input')?.focus();
    });

    document.querySelector('#btn-cancel-global-playlist')?.addEventListener('click', () => {
        document.querySelector('#modal-global-playlist')?.classList.remove('open');
    });

    document.querySelector('#btn-confirm-global-playlist')?.addEventListener('click', async () => {
        const input = document.querySelector('#global-playlist-name-input');
        const btn = document.querySelector('#btn-confirm-global-playlist');
        const name = input?.value.trim();
        if (!name) return;
        if (btn.disabled) return;
        btn.disabled = true;
        btn.textContent = 'Creating…';
        try {
            const resp = await fetch('/playlists', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name })
            });
            const data = await resp.json();
            if (resp.ok) {
                input.value = '';
                document.querySelector('#modal-global-playlist')?.classList.remove('open');
                showToast(`Playlist "${name}" created!`, 'success');
                refreshSidebarPlaylists();
                if (window.location.pathname.startsWith('/playlists')) setTimeout(() => location.reload(), 600);
            } else {
                showToast(data.error || 'Failed to create playlist.', 'error');
            }
        } catch(err) {
            showToast('Connection error.', 'error');
        } finally {
            btn.disabled = false;
            btn.textContent = 'Create';
        }
    });

    document.addEventListener('click', async (e) => {
        const btn = e.target.closest('[data-add-to-playlist]');
        if (!btn) return;
        e.preventDefault(); e.stopPropagation();
        const songId = parseInt(btn.dataset.addToPlaylist);
        const modal = document.querySelector('#modal-add-to-playlist');
        const optionsContainer = document.querySelector('#add-to-playlist-options');
        modal?.classList.add('open');
        optionsContainer.innerHTML = '<p style="font-size:0.85rem;color:var(--text-muted)">Loading playlists...</p>';
        try {
            const resp = await fetch('/playlists/data');
            const playlists = await resp.json();
            optionsContainer.innerHTML = '';
            if (!playlists.length) {
                optionsContainer.innerHTML = '<p style="font-size:0.85rem;color:var(--text-muted)">No playlists found. Create one first.</p>';
                return;
            }
            playlists.forEach(p => {
                const btnItem = document.createElement('button');
                btnItem.className = 'btn btn-secondary';
                btnItem.style.cssText = 'width:100%;justify-content:space-between;';
                btnItem.innerHTML = `<span>${escHtml(p.name)}</span><span style="font-size:0.75rem;color:var(--text-muted)">${p.songCount || 0} songs</span>`;
                btnItem.addEventListener('click', async () => {
                    const addResp = await fetch(`/playlists/${p.id}/songs`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ songId })
                    });
                    const addData = await addResp.json();
                    if (addResp.ok) {
                        showToast(`Added to "${p.name}"!`, 'success');
                        modal?.classList.remove('open');
                        refreshSidebarPlaylists();
                    } else {
                        showToast(addData.error || 'Song already in this playlist.', 'error');
                    }
                });
                optionsContainer.appendChild(btnItem);
            });
        } catch(e) {
            optionsContainer.innerHTML = '<p style="font-size:0.85rem;color:#fda4af">Failed to load playlists.</p>';
        }
    });

    document.querySelector('#btn-cancel-add-to-playlist')?.addEventListener('click', () => {
        document.querySelector('#modal-add-to-playlist')?.classList.remove('open');
    });
});
</script>

<script>
/* ── LIVE SEARCH ─────────────────────────────────────────── */
(function () {
    const input   = document.getElementById('live-search-input');
    const spinner = document.getElementById('search-spinner');
    const SONGS_URL = '/songs';
    let debounceTimer = null;
    let lastQuery = input ? input.value.trim() : '';
    const isLibraryPage = () => window.location.pathname === '/' || window.location.pathname.startsWith('/songs');

    function renderSongsTable(songs) {
        const main = document.getElementById('main-view');
        if (!main) return;

        if (songs.length === 0) {
            main.innerHTML = `
                <div class="page-header">
                    <div><h1 class="page-title">Search results</h1>
                    <div class="page-subtitle">0 songs found</div></div>
                </div>
                <div style="text-align:center;padding:80px 20px;color:var(--text-muted)">
                    <p style="font-size:1.1rem">No songs matching your query.</p>
                </div>`;
            window._songQueue = [];
            return;
        }

        let rows = '';
        songs.forEach((s, i) => {
            const dur = s.formattedDuration || '';
            rows += `<tr data-song-id="${s.id}" role="row" tabindex="0">
                <td class="col-num"><span class="row-num">${i+1}</span>
                    <svg class="playing-indicator" viewBox="0 0 24 24" fill="currentColor">
                        <rect x="2" y="10" width="4" height="10" rx="1"><animate attributeName="height" values="10;4;10" dur="1s" repeatCount="indefinite"/><animate attributeName="y" values="10;14;10" dur="1s" repeatCount="indefinite"/></rect>
                        <rect x="10" y="6" width="4" height="14" rx="1"><animate attributeName="height" values="14;6;14" dur="0.8s" repeatCount="indefinite"/><animate attributeName="y" values="6;10;6" dur="0.8s" repeatCount="indefinite"/></rect>
                        <rect x="18" y="8" width="4" height="12" rx="1"><animate attributeName="height" values="12;5;12" dur="1.2s" repeatCount="indefinite"/><animate attributeName="y" values="8;12;8" dur="1.2s" repeatCount="indefinite"/></rect>
                    </svg></td>
                <td class="col-title">${escHtml(s.title)}</td>
                <td>${escHtml(s.artist || '')}</td>
                <td>${escHtml(s.album || '')}</td>
                <td class="col-plays"><span class="plays-badge">${s.playCount || 0}</span></td>
                <td class="col-duration">${dur}</td>
                <td class="col-actions">
                    <button class="btn btn-ghost btn-sm btn-icon btn-action" data-add-to-playlist="${s.id}" title="Add to playlist">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </button>
                </td>
            </tr>`;
        });

        main.innerHTML = `
            <div class="page-header">
                <div><h1 class="page-title">Search results</h1>
                <div class="page-subtitle">${songs.length} song${songs.length !== 1 ? 's' : ''} found</div></div>
            </div>
            <table class="song-table" role="grid">
                <thead><tr>
                    <th class="col-num">#</th>
                    <th>Title</th><th>Artist</th><th>Album</th>
                    <th class="col-plays">Plays</th>
                    <th class="col-duration">Time</th>
                    <th class="col-actions"></th>
                </tr></thead>
                <tbody id="songs-tbody">${rows}</tbody>
            </table>`;

        window._songQueue = songs.map(s => ({
            id: s.id, title: s.title, artist: s.artist, album: s.album,
            duration: s.duration, formattedDuration: s.formattedDuration,
            playCount: s.playCount || 0, streamUrl: s.streamUrl
        }));
        if (window.player) window.player.setQueue(window._songQueue, null);
    }

    async function doSearch(q) {
        if (spinner) spinner.classList.remove('hidden');
        try {
            const resp = await fetch(`${SONGS_URL}?q=${encodeURIComponent(q)}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!resp.ok) return;
            const songs = await resp.json();
            renderSongsTable(songs);
        } catch(e) {
            /* silently ignore */
        } finally {
            if (spinner) spinner.classList.add('hidden');
        }
    }

    async function resetToAllSongs() {
        if (spinner) spinner.classList.remove('hidden');
        try {
            const resp = await fetch(`${SONGS_URL}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!resp.ok) return;
            const songs = await resp.json();
            renderSongsTable(songs);
        } catch(e) {}
        finally { if (spinner) spinner.classList.add('hidden'); }
    }

    if (input) {
        input.addEventListener('input', () => {
            clearTimeout(debounceTimer);
            const q = input.value.trim();

            if (q === lastQuery) return;
            lastQuery = q;

            debounceTimer = setTimeout(() => {
                if (q.length === 0) {
                    resetToAllSongs();
                } else {
                    doSearch(q);
                }
            }, 280);
        });

        input.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') { e.preventDefault(); }
        });

        /* Auto-trigger search on page load if q param is present in URL */
        if (isLibraryPage() && lastQuery.length > 0) {
            doSearch(lastQuery);
        }
    }
})();
</script>

<script>
/* ── SPA ROUTER ──────────────────────────────────────────── */
(function () {
    const mainView = document.getElementById('main-view');
    if (!mainView) return;

    /* Selectors of links that should use SPA navigation */
    const NAV_SELECTOR = '.sidebar-link, .sidebar-playlist-item, [data-spa-link]';

    /* Pages that have page-specific <script> blocks we need to re-run */
    function runInlineScripts(container) {
        container.querySelectorAll('script').forEach(oldScript => {
            const newScript = document.createElement('script');
            if (oldScript.src) {
                newScript.src = oldScript.src;
                newScript.async = false;
            } else {
                newScript.textContent = oldScript.textContent;
            }
            oldScript.parentNode.replaceChild(newScript, oldScript);
        });
    }

    /* Update sidebar active state */
    function updateSidebarActive(url) {
        const path = new URL(url, location.origin).pathname;
        document.querySelectorAll('.sidebar-link').forEach(a => {
            const href = a.getAttribute('href');
            const isActive = href && (path === href || (path.startsWith(href) && href !== '/'));
            a.classList.toggle('active', !!isActive);
        });
        document.querySelectorAll('.sidebar-playlist-item').forEach(a => {
            const href = a.getAttribute('href');
            a.classList.toggle('active', href && path === href);
        });
    }

    async function navigateTo(url, pushState = true) {
        try {
            const resp = await fetch(url, {
                headers: { 'X-SPA-Request': '1' }
            });
            if (!resp.ok) { window.location.href = url; return; }

            const html = await resp.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            /* Swap main content */
            const newMain = doc.getElementById('main-view');
            if (!newMain) { window.location.href = url; return; }

            mainView.innerHTML = newMain.innerHTML;
            runInlineScripts(mainView);

            /* Update page title */
            const newTitle = doc.querySelector('title');
            if (newTitle) document.title = newTitle.textContent;

            /* Update search input value from URL */
            const q = new URL(url, location.origin).searchParams.get('q') || '';
            const searchInput = document.getElementById('live-search-input');
            if (searchInput) searchInput.value = q;

            /* Push to browser history */
            if (pushState) history.pushState({ url }, '', url);

            /* Scroll to top */
            mainView.scrollTop = 0;

            /* Update sidebar active links */
            updateSidebarActive(url);

        } catch (e) {
            /* Fallback: normal navigation */
            window.location.href = url;
        }
    }

    /* Intercept clicks on nav links */
    document.addEventListener('click', (e) => {
        const link = e.target.closest(NAV_SELECTOR);
        if (!link) return;
        const href = link.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('http') || e.ctrlKey || e.metaKey || e.shiftKey) return;
        e.preventDefault();
        navigateTo(href);
    });

    /* Handle browser back / forward */
    window.addEventListener('popstate', (e) => {
        const url = e.state?.url || location.href;
        navigateTo(url, false);
    });

    /* Save initial state */
    history.replaceState({ url: location.href }, '', location.href);
})();
</script>

{% block javascripts %}{% endblock %}
</body>
</html>