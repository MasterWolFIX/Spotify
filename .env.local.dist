# Copy this file to .env.local and fill in your values
# .env.local is NOT committed to version control

APP_ENV=dev
APP_SECRET=your_very_long_random_secret_here

DATABASE_URL="mysql://app:your_db_password@mariadb:3306/music_player?serverVersion=mariadb-11.0.0&charset=utf8mb4"

MARIADB_DATABASE=music_player
MARIADB_USER=app
MARIADB_PASSWORD=your_db_password
MARIADB_ROOT_PASSWORD=your_root_password

MUSIC_DIR=/var/lib/music
